generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("user")
  tier         String    @default("free")
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // RBAC:
  // A user can have multiple roles.
  roles         UserRole[]
  refreshTokens RefreshToken[]
  usageLogs     UsageLog[]
  documents     Document[]
  conversations Conversation[]

  @@index([email])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A role can belong to many users.
  users UserRole[]

  // A role can have many permissions.
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  resource    String
  action      String

  createdAt DateTime @default(now())

  // A permission can belong to many roles.
  roles RolePermission[]

  // Prevent duplicate resource/action combinations.
  @@unique([resource, action])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Composite primary key:
  // the same user cannot receive the same role twice.
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Prevent duplicate role/permission assignments.
  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UsageLog {
  id     String  @id @default(uuid())
  userId String?

  // What happened?
  //
  // Examples:
  // document_created
  // document_deleted
  // chat
  // login
  // token_refresh
  action String

  // LLM usage information.
  tokens  Int   @default(0)
  costUsd Float @default(0)

  // Additional event-specific information.
  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Document {
  id     String @id @default(cuid())
  userId String

  title       String
  description String?
  filename    String

  // Current document-processing state.
  //
  // Examples:
  // pending
  // processing
  // ready
  // failed
  status String @default("pending")

  // Number of chunks generated from this document.
  //
  // Keeping this as a denormalized counter makes listing
  // documents cheap without counting Chunk rows every time.
  chunkCount Int @default(0)

  // File size is useful for usage limits and reporting.
  fileSizeBytes Int?

  // Soft-delete fields.
  //
  // We don't physically remove the document.
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  chunks Chunk[]

  // A document may be referenced by messages.
  messages Message[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Chunk {
  id         String @id @default(cuid())
  documentId String

  // Position of this chunk within the document.
  chunkIndex Int

  // The actual extracted text.
  content String

  // Useful later for RAG/vector search.
  //
  // We aren't storing an embedding here yet because
  // the vector-database portion comes later.
  tokenCount Int?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model Conversation {
  id     String @id @default(cuid())
  userId String

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id             String @id @default(cuid())
  conversationId String

  // Optional because a normal conversation message
  // doesn't necessarily reference a document.
  documentId String?

  // "user" or "assistant"
  role String

  content String

  // Token/cost information becomes useful once
  // actual LLM calls are introduced.
  promptTokens     Int?
  completionTokens Int?
  costUsd          Float?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([documentId])
  @@index([createdAt])
}

model WebhookEvent {
  id           String   @id  // The provider's event ID
  provider     String         // 'stripe', 'github', etc.
  eventType    String         // 'payment.succeeded', etc.
  receivedAt   DateTime @default(now())
  processedAt  DateTime?
  payload      String         // Raw payload for debugging

  @@index([provider, eventType])
}
